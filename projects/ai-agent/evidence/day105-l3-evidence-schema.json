  "$defs": {
    "non_empty": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE",
        "NOT_RUN"
      ]
    },
    "nullable_datetime": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "identity_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "digest"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/non_empty"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "gate_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "safe_reason",
        "evidence_ids",
        "evidence_digests",
        "observed_at"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "safe_reason": {
          "$ref": "#/$defs/non_empty"
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty"
          }
        },
        "evidence_digests": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "observed_at": {
          "$ref": "#/$defs/nullable_datetime"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "INCONCLUSIVE"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "minItems": 1
              },
              "evidence_digests": {
                "minItems": 1
              },
              "observed_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "NOT_RUN"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "maxItems": 0
              },
              "evidence_digests": {
                "maxItems": 0
              },
              "observed_at": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "security_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "category",
        "generation_id",
        "expected_stage_result",
        "observed_stage_result",
        "expected_serving_action",
        "serving_action",
        "defense_outcome",
        "expectation_conformant",
        "prompt_occurrence_ids",
        "released_citation_occurrence_ids",
        "evidence_digest"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/non_empty"
