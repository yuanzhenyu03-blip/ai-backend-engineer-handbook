{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "day106-l3b-external-evidence.v1",
  "title": "Day106 L3B content-safe external-model evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "run_id",
    "status",
    "evidence_level",
    "started_at",
    "completed_at",
    "same_database_execution",
    "artifact_digests",
    "day105_execution_checksum",
    "external_call_count",
    "observed_output_tokens_total",
    "external_calls",
    "zero_call_gates",
    "pending_g2_after_p2",
    "hard_gates",
    "restart_evidence",
    "raw_prompt_logged",
    "protected_chunk_logged",
    "answer_candidate_text_logged",
    "raw_provider_response_logged",
    "raw_provider_response_id_logged",
    "raw_secret_logged",
    "raw_vector_logged",
    "database_url_logged",
    "max_output_tokens",
    "reasoning_effort",
    "store",
    "tools_enabled",
    "provider_call_budget",
    "canonical_python_3_12",
    "transport_boundary",
    "transport_boundary_digest",
    "external_model_boundary",
    "external_dlp_boundary",
    "production_iam_rls_tls_egress",
    "production_readiness",
    "claim_boundary",
    "report_checksum"
  ],
  "properties": {
    "schema_version": {"const": "day106-l3b-external-evidence.v1"},
    "scenario_id": {"const": "day106-production-rag-db-external-provider-l3b-v1"},
    "run_id": {"type": "string", "pattern": "^day106-l3b-[0-9a-f]{16}$"},
    "status": {"const": "PASS"},
    "evidence_level": {"const": "EXECUTED_LOCAL_POSTGRESQL_PGVECTOR_AND_EXTERNAL_MODEL_BOUNDARY"},
    "started_at": {"$ref": "#/$defs/datetime"},
    "completed_at": {"$ref": "#/$defs/datetime"},
    "same_database_execution": {"const": true},
    "artifact_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integration_runner",
        "evidence_schema",
        "database_schema",
        "capstone_repository",
        "compose",
        "openai_adapter",
        "production_capstone",
        "capstone_support",
        "grounding_adapters",
        "grounding_orchestrator",
        "day105_integration_runner",
        "day106_l3a_integration_runner",
        "restart_runner",
        "evidence_replay_runner",
        "base_commit"
      ],
      "properties": {
        "integration_runner": {"$ref": "#/$defs/digest"},
        "evidence_schema": {"$ref": "#/$defs/digest"},
        "database_schema": {"$ref": "#/$defs/digest"},
        "capstone_repository": {"$ref": "#/$defs/digest"},
        "compose": {"$ref": "#/$defs/digest"},
        "openai_adapter": {"$ref": "#/$defs/digest"},
        "production_capstone": {"$ref": "#/$defs/digest"},
        "capstone_support": {"$ref": "#/$defs/digest"},
        "grounding_adapters": {"$ref": "#/$defs/digest"},
        "grounding_orchestrator": {"$ref": "#/$defs/digest"},
        "day105_integration_runner": {"$ref": "#/$defs/digest"},
        "day106_l3a_integration_runner": {"$ref": "#/$defs/digest"},
        "restart_runner": {"$ref": "#/$defs/digest"},
        "evidence_replay_runner": {"$ref": "#/$defs/digest"},
        "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "day105_execution_checksum": {"$ref": "#/$defs/digest"},
    "external_call_count": {"const": 5},
    "observed_output_tokens_total": {"type": "integer", "minimum": 0, "maximum": 320},
    "external_calls": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/external_call"}
    },
    "zero_call_gates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "DAY105_SECURITY_NEGATIVE_CONTROLS",
          "G3_P2_Q1_REQUIRED_A_UNAVAILABLE",
          "G3_P2_Q3_REQUIRED_A_UNAVAILABLE"
        ]
      }
    },
    "pending_g2_after_p2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "safe_reason_codes", "response_dispatch_state"],
      "properties": {
        "disposition": {"const": "BLOCKED"},
        "safe_reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "response_dispatch_state": {"const": "NOT_ATTEMPTED"}
      }
    },
    "hard_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_database_execution_not_independent_pass_stitching",
        "real_pgvector_readview_each_external_query",
        "exact_request_rb_cam_mi_provider_binding",
        "model_invocation_persisted_pre_send",
        "provider_attempt_reserved_pre_send",
        "shared_call_budget_exactly_five",
        "each_observed_output_tokens_at_most_64",
        "observed_output_tokens_total_at_most_320",
        "all_security_negative_controls_zero_external_calls",
        "g3_q1_q3_zero_external_calls",
        "pending_g2_candidate_blocked_after_p2",
        "g3_p2_q2_released",
        "unauthorized_occurrence_entering_prompt_zero",
        "pre_restart_durable_state_sealed"
      ],
      "properties": {
        "one_database_execution_not_independent_pass_stitching": {"const": "PASS"},
        "real_pgvector_readview_each_external_query": {"const": "PASS"},
        "exact_request_rb_cam_mi_provider_binding": {"const": "PASS"},
        "model_invocation_persisted_pre_send": {"const": "PASS"},
        "provider_attempt_reserved_pre_send": {"const": "PASS"},
        "shared_call_budget_exactly_five": {"const": "PASS"},
        "each_observed_output_tokens_at_most_64": {"const": "PASS"},
        "observed_output_tokens_total_at_most_320": {"const": "PASS"},
        "all_security_negative_controls_zero_external_calls": {"const": "PASS"},
        "g3_q1_q3_zero_external_calls": {"const": "PASS"},
        "pending_g2_candidate_blocked_after_p2": {"const": "PASS"},
        "g3_p2_q2_released": {"const": "PASS"},
        "unauthorized_occurrence_entering_prompt_zero": {"const": "PASS"},
        "pre_restart_durable_state_sealed": {"const": "PASS"}
      }
    },
    "restart_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "pre_restart_postmaster_started_at",
        "pre_restart_state_digest",
        "artifact_counts",
        "artifact_identity_count",
        "post_restart_postmaster_started_at",
        "post_restart_state_digest"
      ],
      "properties": {
        "status": {"const": "PRE_RESTART_SEALED"},
        "pre_restart_postmaster_started_at": {"$ref": "#/$defs/datetime"},
        "pre_restart_state_digest": {"$ref": "#/$defs/digest"},
        "artifact_counts": {"$ref": "#/$defs/artifact_counts"},
        "artifact_identity_count": {"const": 34},
        "post_restart_postmaster_started_at": {"type": "null"},
        "post_restart_state_digest": {"type": "null"}
      }
    },
    "raw_prompt_logged": {"const": false},
    "protected_chunk_logged": {"const": false},
    "answer_candidate_text_logged": {"const": false},
    "raw_provider_response_logged": {"const": false},
    "raw_provider_response_id_logged": {"const": false},
    "raw_secret_logged": {"const": false},
    "raw_vector_logged": {"const": false},
    "database_url_logged": {"const": false},
    "max_output_tokens": {"const": 64},
    "reasoning_effort": {"const": "low"},
    "store": {"const": false},
    "tools_enabled": {"const": false},
    "provider_call_budget": {"const": 5},
    "canonical_python_3_12": {"const": "NOT_RUN"},
    "transport_boundary": {"const": "REAL_URLLIB_OPENAI_RESPONSES_HTTPS"},
    "transport_boundary_digest": {
      "const": "sha256:85cf92463e78dab37a95b2a090f0d7073acab1f62ac9bfaa1ef563c378701788"
    },
    "external_model_boundary": {"const": "PASS"},
    "external_dlp_boundary": {"const": "NOT_RUN"},
    "production_iam_rls_tls_egress": {"const": "NOT_RUN"},
    "production_readiness": {"const": "MORE_EVIDENCE_NEEDED"},
    "claim_boundary": {"type": "string", "minLength": 1, "maxLength": 2048},
    "report_checksum": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "datetime": {"type": "string", "format": "date-time"},
    "artifact_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ANSWER_RELEASE",
        "DISPATCH_RECORD",
        "DISPATCH_WINNER",
        "MODEL_INVOCATION",
        "PROVIDER_ATTEMPT",
        "PROVIDER_RECEIPT",
        "REQUEST_BINDING",
        "RESPONSE_INTENT",
        "RETRIEVAL_CONTEXT_RECEIPT"
      ],
      "properties": {
        "ANSWER_RELEASE": {"const": 5},
        "DISPATCH_RECORD": {"const": 0},
        "DISPATCH_WINNER": {"const": 0},
        "MODEL_INVOCATION": {"const": 5},
        "PROVIDER_ATTEMPT": {"const": 5},
        "PROVIDER_RECEIPT": {"const": 5},
        "REQUEST_BINDING": {"const": 5},
        "RESPONSE_INTENT": {"const": 4},
        "RETRIEVAL_CONTEXT_RECEIPT": {"const": 5}
      }
    },
    "external_call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "generation_id",
        "authorization_snapshot_id",
        "request_binding_digest",
        "retrieval_context_receipt_digest",
        "retrieval_bundle_digest",
        "context_manifest_digest",
        "model_invocation_digest",
        "provider_attempt_digest",
        "provider_receipt_digest",
        "answer_candidate_digest",
        "provider_status",
        "call_ordinal",
        "input_token_count",
        "output_token_count",
        "total_token_count",
        "release_disposition",
        "safe_reason_codes",
        "unauthorized_prompt_count"
      ],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 64},
        "generation_id": {"enum": ["G2", "G3"]},
        "authorization_snapshot_id": {"enum": ["P1", "P2"]},
        "request_binding_digest": {"$ref": "#/$defs/digest"},
        "retrieval_context_receipt_digest": {"$ref": "#/$defs/digest"},
        "retrieval_bundle_digest": {"$ref": "#/$defs/digest"},
        "context_manifest_digest": {"$ref": "#/$defs/digest"},
        "model_invocation_digest": {"$ref": "#/$defs/digest"},
        "provider_attempt_digest": {"$ref": "#/$defs/digest"},
        "provider_receipt_digest": {"$ref": "#/$defs/digest"},
        "answer_candidate_digest": {"$ref": "#/$defs/digest"},
        "provider_status": {"const": "SUCCEEDED"},
        "call_ordinal": {"type": "integer", "minimum": 1, "maximum": 5},
        "input_token_count": {"type": "integer", "minimum": 0},
        "output_token_count": {"type": "integer", "minimum": 0, "maximum": 64},
        "total_token_count": {"type": "integer", "minimum": 0},
        "release_disposition": {"enum": ["RELEASE", "BLOCKED"]},
        "safe_reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "unauthorized_prompt_count": {"const": 0}
      }
    }
  }
}
